@model ShipOrderDto

@{
    ViewData["Title"] = "Ship Order";
}

<section class="shop-ops-shell">
    <div class="ops-hero">
        <div>
            <p class="ops-kicker">DS2 E-Shop</p>
            <h1>Ship order</h1>
        </div>
    </div>

    <main class="ship-card ship-card-narrow">
        <div class="panel-heading">
            <div>
                <p class="ops-kicker">Transaction</p>
                <h2>Order shipping</h2>
            </div>
        </div>

        @if (ViewData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        <form asp-action="Index" method="post" class="ship-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-field">
                <label asp-for="OrderId" class="form-label"></label>
                <input asp-for="OrderId" class="form-control" type="number" min="1" />
                <span asp-validation-for="OrderId" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="WarehouseId" class="form-label"></label>
                <input asp-for="WarehouseId" class="form-control" type="number" min="1" />
                <span asp-validation-for="WarehouseId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary ship-button">Ship order</button>
        </form>
    </main>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
