@model List<ProductListItemDto>

@{
    ViewData["Title"] = "Products";
}

<section class="shop-simple-page shop-wide-page">
    <p class="ops-kicker">Catalog</p>
    <h1>Products</h1>

    <div class="table-responsive shop-table-wrap">
        <table class="table shop-table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">VAT</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-muted">No products to display.</td>
                    </tr>
                }
                else
                {
                    foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>@product.Name</td>
                            <td>@product.CategoryName</td>
                            <td class="text-end">@product.Price.ToString("0.00")</td>
                            <td class="text-end">@product.Vat.ToString("0.##")%</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
