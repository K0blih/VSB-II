@model WarehousePageDto

@{
    ViewData["Title"] = "Warehouses";
}

<section class="shop-simple-page shop-wide-page">
    <p class="ops-kicker">Stock</p>
    <h1>Warehouses</h1>

    <div class="warehouse-grid">
        @if (Model.Warehouses.Count == 0)
        {
            <div class="empty-state">No warehouses to display.</div>
        }
        else
        {
            foreach (var warehouse in Model.Warehouses)
            {
                <article class="warehouse-card">
                    <h2>@warehouse.Name</h2>
                    <p>Warehouse ID: @warehouse.WarehouseId</p>
                    <p>@warehouse.City</p>
                </article>
            }
        }
    </div>

    <div class="table-responsive shop-table-wrap mt-3">
        <table class="table shop-table align-middle">
            <thead>
                <tr>
                    <th>Warehouse</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Reserved</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Stock.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted">No stock to display.</td>
                    </tr>
                }
                else
                {
                    foreach (var stock in Model.Stock)
                    {
                        <tr>
                            <td>@stock.WarehouseId</td>
                            <td>@stock.ProductName</td>
                            <td class="text-end">@stock.Quantity</td>
                            <td class="text-end">@stock.ReservedQuantity</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
