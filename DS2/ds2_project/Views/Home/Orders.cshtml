@model List<OrderListItemDto>

@{
    ViewData["Title"] = "Orders";
}

<section class="shop-simple-page shop-wide-page">
    <p class="ops-kicker">Orders</p>
    <h1>Orders</h1>

    <div class="table-responsive shop-table-wrap">
        <table class="table shop-table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-muted">No orders to display.</td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td>@order.CustomerName</td>
                            <td>@order.Status</td>
                            <td>@order.PaymentStatus</td>
                            <td class="text-end">@order.TotalPrice.ToString("0.00")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
